# PostHog project API key (public, safe to ship in the client bundle).
VITE_POSTHOG_KEY=phc_your_project_key

# US Cloud ingestion host. Use https://eu.i.posthog.com for EU Cloud.
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Send analytics from `npm run dev`. Leave false/absent for silent local dev.
VITE_POSTHOG_DEV=false
